@page "/"

<PageTitle>Home</PageTitle>


<div class="text-center alert alert-primary mb-4">
    <h1 class="display-5">Student Grade</h1>
    <p class="text-secondary">Enter up to five grades and get complete analysis of your performance.</p>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h5 class="mb-3">
            <i class="bi bi-pencil-fill text-primary me-2"></i>
            Enter Student Information
        </h5>

        <div class="row g-3">
            <div class="col-md-8">
                <div class="row g-3">

                    <div class="col-12">
                        <label for="studentName" class="form-label">Student Name</label>
                        <input type="text" class="form-control" id="studentName"
                               placeholder="Enter student name..."
                               @bind="studentName" />
                    </div>

                    <div class="col">
                        <label for="grade1" class="form-label">Grade 1</label>
                        <input type="number" class="form-control" id="grade1"
                               placeholder="0-100"
                               @bind="grade1" />
                    </div>

                    <div class="col">
                        <label for="grade2" class="form-label">Grade 2</label>
                        <input type="number" class="form-control" id="grade2"
                               placeholder="0-100"
                               @bind="grade2" />
                    </div>
                    <div class="col">
                        <label for="grade3" class="form-label">Grade 3</label>
                        <input type="number" class="form-control" id="grade3"
                               placeholder="0-100"
                               @bind="grade3" />
                    </div>

                    <div class="col">
                        <label for="grade4" class="form-label">Grade 4</label>
                        <input type="number" class="form-control" id="grade4"
                               placeholder="0-100"
                               @bind="grade4" />
                    </div>

                    <div class="col">
                        <label for="grade5" class="form-label">Grade 5</label>
                        <input type="number" class="form-control" id="grade5"
                               placeholder="0-100"
                               @bind="grade5" />
                    </div>

                </div>

            </div>

            <div class="col-md-4">
                <div class="alert alert-primary">
                    <h6 class="mb-3">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        Instructions
                    </h6>

                    <ul class="">
                        <li>Enter the student's name.</li>
                        <li>Enter five grades from 0 to 100.</li>
                        <li>Click Analyze Grades.</li>
                        <li>View the results below.</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="row d-flex justify-content-center my-4">
            <button type="button" class="btn btn-primary col-4 py-2" @onclick="Analyze">
                <i class="bi bi-bar-chart-fill me-2"></i>
                Analyze Grades
            </button>
        </div>

    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="row">
            <h5 class="mb-3">
                <i class="bi bi-bar-chart-fill text-primary me-2"></i>
                Results
            </h5>
            @if (savedStudentName.Length > 0)
            {
                <p class="text-secondary mb-4">
                    Grade analysis for <strong>@savedStudentName</strong>
                </p>
            }
            else
            {
                <p class="text-secondary mb-4">
                    Your grade analysis will appear here.
                </p>
            }
        </div>

        <div class="row g-2">
            <div class="col-md-3">
                <div class="alert alert-primary text-primary">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-calculator-fill fs-4 me-3"></i>
                        <div>
                            <div class="small">Average</div>
                            @if (average > 0)
                            {
                                <div class="fw-bold fs-5">@average.ToString("F2")</div>
                            }
                            else
                            {
                                <div class="fw-bold fs-5">--</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="alert alert-success text-success">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-arrow-up-circle-fill fs-4 me-3"></i>
                        <div>
                            <div class="small">Highest Grade</div>
                            @if (highestGrade > 0)
                            {
                                <div class="fw-bold fs-5">@highestGrade.ToString("F2")</div>
                            }
                            else
                            {
                                <div class="fw-bold fs-5">--</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="alert alert-danger text-danger">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-arrow-down-circle-fill fs-4 me-3"></i>
                        <div>
                            <div class="small">Lowest Grade</div>
                            @if (lowestGrade > 0)
                            {
                                <div class="fw-bold fs-5">@lowestGrade.ToString("F2")</div>
                            }
                            else
                            {
                                <div class="fw-bold fs-5">--</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="alert custom-purple">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-mortarboard-fill fs-4 me-3"></i>
                        <div>
                            <div class="small">Letter Grade</div>
                            @if (letterGrade != '-')
                            {
                                <div class="fw-bold fs-5">@letterGrade</div>
                            }
                            else
                            {
                                <div class="fw-bold fs-5">--</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="alert alert-success text-success">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-check-circle-fill fs-4 me-3"></i>
                        <div>
                            <div class="small">Passing Grades</div>
                            @if (passingGrades > 0)
                            {
                                <div class="fw-bold fs-5">@passingGrades</div>
                            }
                            else
                            {
                                <div class="fw-bold fs-5">--</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="alert alert-danger text-danger">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-x-circle-fill fs-4 me-3"></i>
                        <div>
                            <div class="small">Falling Grades</div>
                            @if (fallingGrades > 0)
                            {
                                <div class="fw-bold fs-5">@fallingGrades</div>
                            }
                            else
                            {
                                <div class="fw-bold fs-5">--</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="alert custom-yellow position-relative overflow-hidden">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-trophy-fill fs-4 me-3"></i>
                        <div>
                            <div class="small">Status</div>
                            @if (average >= 60)
                            {
                                <div class="fw-bold fs-5">PASS</div>

                                <canvas id="pass-confetti"></canvas>
                            }
                            else if (average < 60 && average > 0)
                            {
                                <div class="fw-bold fs-5">FAIL</div>
                            }
                            else
                            {
                                <div class="fw-bold fs-5">--</div>
                            }

                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 mt-0">
                <div class="alert alert-dark border text-center">
                    <i class="bi bi-info-circle-fill me-2"></i>
                    Enter your grades and click "Analyze Grades" to see the results.
                </div>
            </div>
        </div>

    </div>
</div>


@code {
    string studentName = string.Empty;
    string savedStudentName = string.Empty;

    double grade1;
    double grade2;
    double grade3;
    double grade4;
    double grade5;

    double average;
    double highestGrade;
    double lowestGrade;
    char letterGrade = '-';
    int passingGrades = 0;
    int fallingGrades = 0;

    
    void Analyze()
    {
        /* Save the student name */
        savedStudentName = studentName;

        /* Get the average */
        average = (grade1 + grade2 + grade3 + grade4 + grade5) / 5;

        /* Get the highest grade*/
        highestGrade = grade1;

        if (grade2 > highestGrade)
        {
            highestGrade = grade2;
        }
        if (grade3 > highestGrade)
        {
            highestGrade = grade3;
        }
        if (grade4 > highestGrade)
        {
            highestGrade = grade4;
        }
        if (grade5 > highestGrade)
        {
            highestGrade = grade5;
        }

        /* Get the lowest grade */
        lowestGrade = grade1;

        if (grade2 < lowestGrade)
        {
            lowestGrade = grade2;
        }
        if (grade3 < lowestGrade)
        {
            lowestGrade = grade3;
        }
        if (grade4 < lowestGrade)
        {
            lowestGrade = grade4;
        }
        if (grade5 < lowestGrade)
        {
            lowestGrade = grade5;
        }

        /* Get letter grade */

        if (average >= 90)
        {
            letterGrade = 'A';
        }

        else if (average >= 80)
        {
            letterGrade = 'B';
        }

        else if (average >= 70)
        {
            letterGrade = 'C';
        }

        else if (average >= 60)
        {
            letterGrade = 'D';
        }
        else
        {
            letterGrade = 'F';
        }

        /* Get passing grades */

        if (grade1 >= 60)
        {
            passingGrades++;
        }
        if (grade2 >= 60)
        {
            passingGrades++;
        }
        if (grade3 >= 60)
        {
            passingGrades++;
        }
        if (grade4 >= 60)
        {
            passingGrades++;
        }
        if (grade5 >= 60)
        {
            passingGrades++;
        }

        /* Get falling grades */
        if (grade1 < 60)
        {
            fallingGrades++;
        }
        if (grade2 < 60)
        {
            fallingGrades++;
        }
        if (grade3 < 60)
        {
            fallingGrades++;
        }
        if (grade4 < 60)
        {
            fallingGrades++;
        }
        if (grade5 < 60)
        {
            fallingGrades++;
        }


        clearInputs();
    }

    void clearInputs()
    {
        studentName = string.Empty;
        grade1 = 0;
        grade2 = 0;
        grade3 = 0;
        grade4 = 0;
        grade5 = 0;
    }
}

